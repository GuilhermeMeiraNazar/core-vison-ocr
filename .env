# =============================================================================
# Core Vision OCR — Configuração Centralizada
# =============================================================================
# Edite este arquivo e reinicie. Nenhuma alteração de código necessária.

# ── DPI da rasterização ──────────────────────────────────────────────────
DPI=600

# ── Tiling do OCR ────────────────────────────────────────────────────────
TILE_SIZE=2000
OVERLAP=200
DEDUPE_PX=60

# ── Chunking de rasterização ─────────────────────────────────────────────
CHUNK_MAX_RASTER_MB=1536
CHUNK_OVERLAP_PX=200

# ── Diretórios ───────────────────────────────────────────────────────────
INPUT_DIR=./input
OUTPUT_DIR=./output
TEMP_DIR=./temp
DEBUG_DIR=./debug

# ── Debug ────────────────────────────────────────────────────────────────
DEBUG_SAVE_PNG=true
